@{
    ViewData["Title"] = "Dashboard";
}

<div class="row align-items-center mb-5 mt-3">
    <div class="col-lg-8">
        <h1 class="display-5 fw-bold text-dark"><i class="bi bi-calendar2-check text-primary"></i> Agenda de Palestras</h1>
        <p class="lead text-muted">Sistema de administração de congregações, oradores, discursos e agendamentos com notificações automatizadas via WhatsApp.</p>
    </div>
    <div class="col-lg-4 text-lg-end">
        <a asp-controller="Agenda" asp-action="Index" class="btn btn-primary btn-lg"><i class="bi bi-calendar3"></i> Acessar Agenda</a>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0 border-top border-primary border-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="card-title text-primary mb-0"><i class="bi bi-building"></i> Congregações</h5>
                </div>
                <p class="card-text text-muted">Gerencie as congregações parceiras, cidades, circuitos e horários padrão de reuniões.</p>
                <div class="d-flex gap-2">
                    <a asp-controller="Congregacoes" asp-action="Index" class="btn btn-outline-primary btn-sm">Listar Todas</a>
                    <a asp-controller="Congregacoes" asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus"></i> Nova</a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0 border-top border-success border-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="card-title text-success mb-0"><i class="bi bi-person-lines-fill"></i> Oradores</h5>
                </div>
                <p class="card-text text-muted">Cadastre os oradores convidados e configure o repertório de discursos que cada um proferirá.</p>
                <div class="d-flex gap-2">
                    <a asp-controller="Oradores" asp-action="Index" class="btn btn-outline-success btn-sm">Listar Todos</a>
                    <a asp-controller="Oradores" asp-action="Create" class="btn btn-success btn-sm text-white"><i class="bi bi-plus"></i> Novo</a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0 border-top border-info border-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="card-title text-info mb-0"><i class="bi bi-journal-text"></i> Discursos</h5>
                </div>
                <p class="card-text text-muted">Mantenha o catálogo de temas e números dos discursos públicos para montagem de repertórios.</p>
                <div class="d-flex gap-2">
                    <a asp-controller="Discursos" asp-action="Index" class="btn btn-outline-info btn-sm">Catálogo</a>
                    <a asp-controller="Discursos" asp-action="Create" class="btn btn-info btn-sm text-white"><i class="bi bi-plus"></i> Novo</a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-12">
        <div class="card shadow-sm border-0 border-start border-success border-4">
            <div class="card-body d-flex flex-column flex-md-row justify-content-between align-items-md-center">
                <div class="mb-3 mb-md-0">
                    <h5 class="card-title text-success mb-1"><i class="bi bi-whatsapp"></i> Conexão WhatsApp & Automações</h5>
                    <p class="card-text text-muted mb-0">Conecte seu WhatsApp via QR Code pela Evolution API para envio de convites e lembretes aos oradores.</p>
                </div>
                <div>
                    <a asp-controller="WhatsApp" asp-action="Index" class="btn btn-success"><i class="bi bi-qr-code"></i> Gerenciar WhatsApp</a>
                </div>
            </div>
        </div>
    </div>
</div>
