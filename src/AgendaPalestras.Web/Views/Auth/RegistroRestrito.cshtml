@{
    ViewData["Title"] = "Cadastro Restrito";
    Layout = "_Layout";
    var erro = ViewBag.ErroBloqueio as string ?? "O cadastro é restrito a convites emitidos pelo Super Admin.";
}

<div class="row justify-content-center my-5">
    <div class="col-md-7 col-lg-5">
        <div class="card shadow border-0 text-center p-4">
            <div class="card-body">
                <div class="text-warning mb-3">
                    <i class="bi bi-shield-lock-fill" style="font-size: 3.5rem;"></i>
                </div>
                <h3 class="fw-bold text-dark mb-2">Acesso Restrito</h3>
                <p class="text-muted mb-4">
                    @erro
                </p>
                <div class="alert alert-light border small text-start mb-4">
                    <i class="bi bi-info-circle-fill text-primary me-2"></i>
                    Para cadastrar uma nova congregação e criar sua conta no <strong>OradorPro</strong>, solicite ao <strong>Super Admin</strong> do sistema a geração de um link exclusivo de convite.
                </div>
                <div class="d-grid gap-2">
                    <a asp-action="Login" class="btn btn-primary py-2 fw-semibold">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Ir para o Login
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
