@model AgendaPalestras.Web.Models.AgendaCalendarioViewModel
@using AgendaPalestras.Domain.Enums
@{
    ViewData["Title"] = "Agenda de Palestras - Calendário";
    var meses = new[]
    {
        new { Id = 1, Nome = "Janeiro" },
        new { Id = 2, Nome = "Fevereiro" },
        new { Id = 3, Nome = "Março" },
        new { Id = 4, Nome = "Abril" },
        new { Id = 5, Nome = "Maio" },
        new { Id = 6, Nome = "Junho" },
        new { Id = 7, Nome = "Julho" },
        new { Id = 8, Nome = "Agosto" },
        new { Id = 9, Nome = "Setembro" },
        new { Id = 10, Nome = "Outubro" },
        new { Id = 11, Nome = "Novembro" },
        new { Id = 12, Nome = "Dezembro" }
    };

    var diasSemana = new[] { "Domingo", "Segunda", "Terça", "Quarta", "Quinta", "Sexta", "Sábado" };
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="mb-1 fw-bold"><i class="bi bi-calendar3 text-primary"></i> Agenda de Palestras</h2>
        <p class="text-muted mb-0">Visão mensal dos discursos públicos marcados e controle de oradores.</p>
    </div>
    <div class="d-flex gap-2 align-items-center">
        <div class="btn-group shadow-sm" role="group">
            <a asp-action="Index" 
               asp-route-ano="@Model.Ano" 
               asp-route-mes="@Model.Mes" 
               asp-route-congregacaoId="@Model.CongregacaoId" 
               asp-route-modo="calendario" 
               class="btn @(Model.ModoVisualizacao == "calendario" ? "btn-primary" : "btn-outline-secondary")">
                <i class="bi bi-calendar-month me-1"></i> Calendário
            </a>
            <a asp-action="Index" 
               asp-route-ano="@Model.Ano" 
               asp-route-mes="@Model.Mes" 
               asp-route-congregacaoId="@Model.CongregacaoId" 
               asp-route-modo="tabela" 
               class="btn @(Model.ModoVisualizacao == "tabela" ? "btn-primary" : "btn-outline-secondary")">
                <i class="bi bi-table me-1"></i> Lista
            </a>
        </div>
        <a asp-action="Create" asp-route-congregacaoId="@Model.CongregacaoId" class="btn btn-success shadow-sm">
            <i class="bi bi-calendar-plus me-1"></i> Agendar Palestra
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Barra de Navegação do Mês e Filtro -->
<div class="card shadow-sm border-0 mb-4 bg-white">
    <div class="card-body p-3">
        <div class="row g-3 align-items-center justify-content-between">
            <!-- Navegador Rápido de Meses -->
            <div class="col-lg-5 col-md-12 d-flex align-items-center gap-2">
                <a asp-action="Index" 
                   asp-route-ano="@Model.MesAnterior.Year" 
                   asp-route-mes="@Model.MesAnterior.Month" 
                   asp-route-congregacaoId="@Model.CongregacaoId" 
                   asp-route-modo="@Model.ModoVisualizacao" 
                   class="btn btn-outline-secondary btn-sm" 
                   title="Mês Anterior">
                    <i class="bi bi-chevron-left"></i>
                </a>
                
                <h4 class="mb-0 fw-bold text-dark text-nowrap px-2">@Model.NomeMesAno</h4>
                
                <a asp-action="Index" 
                   asp-route-ano="@Model.MesProximo.Year" 
                   asp-route-mes="@Model.MesProximo.Month" 
                   asp-route-congregacaoId="@Model.CongregacaoId" 
                   asp-route-modo="@Model.ModoVisualizacao" 
                   class="btn btn-outline-secondary btn-sm" 
                   title="Próximo Mês">
                    <i class="bi bi-chevron-right"></i>
                </a>

                <a asp-action="Index" 
                   asp-route-ano="@DateTime.Today.Year" 
                   asp-route-mes="@DateTime.Today.Month" 
                   asp-route-congregacaoId="@Model.CongregacaoId" 
                   asp-route-modo="@Model.ModoVisualizacao" 
                   class="btn btn-outline-primary btn-sm ms-2" 
                   title="Mês Atual">
                    Hoje
                </a>
            </div>

            <!-- Seletores de Mês, Ano e Congregação -->
            <div class="col-lg-7 col-md-12">
                <form method="get" class="row g-2 justify-content-lg-end align-items-center">
                    <input type="hidden" name="modo" value="@Model.ModoVisualizacao" />

                    <div class="col-auto">
                        <select name="mes" class="form-select form-select-sm" onchange="this.form.submit()">
                            @foreach (var m in meses)
                            {
                                <option value="@m.Id" selected="@(m.Id == Model.Mes)">@m.Nome</option>
                            }
                        </select>
                    </div>

                    <div class="col-auto">
                        <select name="ano" class="form-select form-select-sm" onchange="this.form.submit()">
                            @for (int a = DateTime.Today.Year - 1; a <= DateTime.Today.Year + 3; a++)
                            {
                                <option value="@a" selected="@(a == Model.Ano)">@a</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-5 col-sm-6">
                        <select name="congregacaoId" class="form-select form-select-sm" onchange="this.form.submit()">
                            <option value="">Todas as Congregações</option>
                            @foreach (var c in Model.Congregacoes)
                            {
                                var selected = (Model.CongregacaoId.HasValue && Model.CongregacaoId.Value == c.Id);
                                <option value="@c.Id" selected="@selected">@c.Nome</option>
                            }
                        </select>
                    </div>

                    <div class="col-auto">
                        <button type="submit" class="btn btn-sm btn-dark"><i class="bi bi-funnel"></i></button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@if (Model.ModoVisualizacao == "calendario")
{
    <!-- Grade do Calendário Mensal -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <!-- Cabeçalho dos Dias da Semana -->
            <div class="row g-0 text-center fw-bold bg-light py-2 border-bottom border-2 text-uppercase small text-muted">
                @foreach (var diaNome in diasSemana)
                {
                    <div class="col" style="flex: 1 0 14.285%;">@diaNome</div>
                }
            </div>

            <!-- Células dos Dias do Mês -->
            <div class="row g-0 calendar-grid">
                @foreach (var dia in Model.Dias)
                {
                    var classeDia = "calendar-day border-bottom border-end p-2 position-relative ";
                    if (!dia.PertenceAoMesAtual)
                    {
                        classeDia += "bg-light bg-opacity-50 text-muted opacity-75 ";
                    }
                    else if (dia.EhHoje)
                    {
                        classeDia += "bg-primary bg-opacity-10 ";
                    }
                    else
                    {
                        classeDia += "bg-white ";
                    }

                    <div class="col @classeDia" style="flex: 1 0 14.285%; min-height: 140px;">
                        <!-- Cabeçalho do Dia (Número + Ação rápida) -->
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="fw-bold @(dia.EhHoje ? "badge bg-primary rounded-pill px-2 py-1" : (dia.PertenceAoMesAtual ? "text-dark" : "text-muted"))" style="font-size: 0.95rem;">
                                @dia.Dia
                            </span>

                            @if (dia.PertenceAoMesAtual)
                            {
                                @if (!dia.TemPalestra)
                                {
                                    <a asp-action="Create" 
                                       asp-route-data="@dia.Data.ToString("yyyy-MM-dd")" 
                                       asp-route-congregacaoId="@Model.CongregacaoId" 
                                       class="btn btn-sm btn-outline-secondary py-0 px-1 text-muted border-0 hover-opacity" 
                                       title="Agendar orador para @dia.Data.ToString("dd/MM/yyyy")">
                                        <i class="bi bi-plus-circle"></i>
                                    </a>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary small border" title="Dia já possui palestra marcada" style="font-size: 0.65rem;">
                                        <i class="bi bi-lock-fill"></i> Ocupado
                                    </span>
                                }
                            }
                        </div>

                        <!-- Lista de Discursos Marcados no Dia -->
                        @if (dia.TemPalestra)
                        {
                            <div class="d-flex flex-column gap-2 mt-1">
                                @foreach (var p in dia.Palestras)
                                {
                                    var cardBg = p.Status switch
                                    {
                                        StatusPalestra.Confirmado => "border-success bg-success bg-opacity-10 text-success-emphasis",
                                        StatusPalestra.Pendente => "border-warning bg-warning bg-opacity-10 text-warning-emphasis",
                                        StatusPalestra.Recusado => "border-danger bg-danger bg-opacity-10 text-danger-emphasis",
                                        StatusPalestra.Cancelado => "border-secondary bg-secondary bg-opacity-10 text-muted",
                                        _ => "border-info bg-info bg-opacity-10 text-dark"
                                    };

                                    var statusBadge = p.Status switch
                                    {
                                        StatusPalestra.Confirmado => "badge bg-success",
                                        StatusPalestra.Pendente => "badge bg-warning text-dark",
                                        StatusPalestra.Recusado => "badge bg-danger",
                                        StatusPalestra.Cancelado => "badge bg-secondary",
                                        _ => "badge bg-light text-dark"
                                    };

                                    <div class="card p-2 shadow-sm border @cardBg" style="font-size: 0.8rem;">
                                        <!-- Horário e Status -->
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span class="fw-bold"><i class="bi bi-clock me-1"></i>@p.DataHora.ToString("HH:mm")</span>
                                            <span class="@statusBadge" style="font-size: 0.65rem;">@p.Status</span>
                                        </div>

                                        <!-- Orador -->
                                        <div class="fw-semibold text-truncate" title="@p.OradorNome">
                                            <i class="bi bi-person-fill text-primary me-1"></i>@p.OradorNome
                                        </div>

                                        <!-- Discurso (Número e Tema Completo) -->
                                        <div class="text-truncate small text-dark fw-bold mt-1" title="Nº @p.DiscursoNumero - @p.DiscursoTema">
                                            <i class="bi bi-book me-1 text-secondary"></i>Nº @p.DiscursoNumero: @p.DiscursoTema
                                        </div>

                                        <!-- Congregação -->
                                        <div class="text-truncate small text-muted mt-1" title="@p.CongregacaoNome">
                                            <i class="bi bi-building me-1"></i>@p.CongregacaoNome
                                        </div>

                                        <!-- Ações rápidas -->
                                        <div class="mt-2 pt-1 border-top d-flex justify-content-between align-items-center">
                                            <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-link p-0 text-decoration-none" title="Ver detalhes completos">
                                                <i class="bi bi-eye"></i> Detalhes
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-link p-0 text-muted text-decoration-none" title="Editar / Reagendar">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}
else
{
    <!-- Visualização Alternativa em Tabela / Lista -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Data e Horário</th>
                            <th>Congregação</th>
                            <th>Orador</th>
                            <th>Tema do Discurso</th>
                            <th>Status</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.TodasAgendas.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">
                                    <i class="bi bi-calendar-x fs-2 d-block mb-2"></i>
                                    Nenhum discurso marcado para este período.
                                </td>
                            </tr>
                        }
                        @foreach (var p in Model.TodasAgendas)
                        {
                            var badgeClass = p.Status switch
                            {
                                StatusPalestra.Confirmado => "bg-success",
                                StatusPalestra.Pendente => "bg-warning text-dark",
                                StatusPalestra.Recusado => "bg-danger",
                                StatusPalestra.Cancelado => "bg-secondary",
                                _ => "bg-light text-dark"
                            };

                            <tr>
                                <td>
                                    <strong>@p.DataHora.ToString("dd/MM/yyyy")</strong>
                                    <span class="text-muted d-block small">@p.DataHora.ToString("HH:mm") (@p.DataHora.ToString("dddd"))</span>
                                </td>
                                <td>@p.CongregacaoNome</td>
                                <td>
                                    <strong>@p.OradorNome</strong>
                                    <span class="text-muted d-block small">@p.OradorTelefone</span>
                                </td>
                                <td>
                                    <span class="badge bg-secondary mb-1">Nº @p.DiscursoNumero</span>
                                    <div class="fw-semibold">@p.DiscursoTema</div>
                                </td>
                                <td>
                                    <span class="badge @badgeClass">@p.Status</span>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-outline-info" title="Detalhes"><i class="bi bi-eye"></i></a>
                                        <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-outline-primary" title="Editar"><i class="bi bi-pencil"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<style>
    .calendar-grid {
        display: flex;
        flex-wrap: wrap;
    }
    .calendar-day {
        min-width: 14.285%;
        transition: background-color 0.2s ease;
    }
    .calendar-day:hover {
        background-color: rgba(13, 110, 253, 0.03);
    }
    .hover-opacity:hover {
        opacity: 1 !important;
        color: #0d6efd !important;
    }
</style>
