@model IEnumerable<AgendaPalestras.Application.DTOs.OradorDto>
@{
    ViewData["Title"] = "Oradores";
    var congregacoes = ViewBag.Congregacoes as IEnumerable<AgendaPalestras.Application.DTOs.CongregacaoDto> ?? Enumerable.Empty<AgendaPalestras.Application.DTOs.CongregacaoDto>();
    Guid? filtroId = ViewBag.FiltroCongregacaoId as Guid?;
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-4 gap-3">
    <div>
        <h2 class="mb-1"><i class="bi bi-person-lines-fill"></i> Oradores Convidados</h2>
        <p class="text-muted small mb-0">Cadastro e repertório de oradores vinculados a congregações parceiras.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus me-1"></i> Novo Orador</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card mb-4 shadow-sm border-0 bg-white">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-12 col-sm-auto">
                <label class="col-form-label fw-bold small text-secondary">Filtrar por Congregação:</label>
            </div>
            <div class="col-12 col-sm-6 col-md-5">
                <select name="congregacaoId" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">Todas as congregações</option>
                    @foreach (var c in congregacoes)
                    {
                        <option value="@c.Id" selected="@(c.Id == filtroId ? "selected" : null)">@c.Nome (@c.Cidade)</option>
                    }
                </select>
            </div>
            @if (filtroId.HasValue)
            {
                <div class="col-12 col-sm-auto">
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Limpar Filtro</a>
                </div>
            }
        </form>
    </div>
</div>

<!-- Visualização Desktop (Tabela Completa) -->
<div class="card shadow-sm border-0 d-none d-md-block">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Nome</th>
                        <th>Congregação de Origem</th>
                        <th>WhatsApp</th>
                        <th>Discursos no Repertório</th>
                        <th>Status</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">Nenhum orador encontrado.</td>
                        </tr>
                    }
                    @foreach (var o in Model)
                    {
                        <tr>
                            <td class="fw-bold">@o.Nome</td>
                            <td><span class="badge bg-light text-dark border">@o.CongregacaoNome</span></td>
                            <td>
                                <a href="https://wa.me/@o.TelefoneWhatsapp" target="_blank" class="text-decoration-none text-success">
                                    <i class="bi bi-whatsapp"></i> @o.TelefoneWhatsapp
                                </a>
                            </td>
                            <td>
                                @if (o.Repertorio.Any())
                                {
                                    <span class="badge bg-info text-dark" title="@string.Join(", ", o.Repertorio.Select(r => $"Nº {r.Numero}"))">
                                        @o.Repertorio.Count discurso(s)
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Sem discursos</span>
                                }
                            </td>
                            <td>
                                @if (o.Ativo)
                                {
                                    <span class="badge bg-success">Ativo</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inativo</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Repertorio" asp-route-id="@o.Id" class="btn btn-sm btn-outline-info" title="Gerenciar Repertório">
                                    <i class="bi bi-journals"></i> Repertório
                                </a>
                                <a asp-action="Edit" asp-route-id="@o.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                                <form asp-action="AlternarStatus" asp-route-id="@o.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm @(o.Ativo ? "btn-outline-warning" : "btn-outline-success")">
                                        @(o.Ativo ? "Desativar" : "Ativar")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Visualização Mobile (Cards Touch-Friendly) -->
<div class="d-md-none">
    @if (!Model.Any())
    {
        <div class="card shadow-sm border-0 text-center py-4">
            <div class="card-body">
                <i class="bi bi-person-x text-muted fs-1 mb-2 d-block"></i>
                <h5 class="fw-bold text-dark">Nenhum orador encontrado</h5>
            </div>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-3 mb-4">
            @foreach (var o in Model)
            {
                <div class="card shadow-sm border-0 mobile-agenda-card border-start border-4 @(o.Ativo ? "border-success" : "border-secondary")">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <h5 class="fw-bold text-dark mb-0">@o.Nome</h5>
                                <span class="badge bg-light text-dark border mt-1">
                                    <i class="bi bi-building me-1"></i>@o.CongregacaoNome
                                </span>
                            </div>
                            <span class="badge @(o.Ativo ? "bg-success" : "bg-danger")">
                                @(o.Ativo ? "Ativo" : "Inativo")
                            </span>
                        </div>

                        <div class="small mb-2">
                            <a href="https://wa.me/@o.TelefoneWhatsapp" target="_blank" class="text-decoration-none text-success fw-bold d-inline-flex align-items-center">
                                <i class="bi bi-whatsapp me-1"></i> @o.TelefoneWhatsapp
                            </a>
                        </div>

                        <div class="mb-3">
                            @if (o.Repertorio.Any())
                            {
                                <span class="badge bg-info-subtle text-info-emphasis border">
                                    <i class="bi bi-journals me-1"></i> @o.Repertorio.Count discurso(s) no repertório
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning-subtle text-warning-emphasis border">
                                    Sem discursos cadastrados
                                </span>
                            }
                        </div>

                        <div class="d-grid gap-2 d-flex flex-wrap border-top pt-2">
                            <a asp-action="Repertorio" asp-route-id="@o.Id" class="btn btn-sm btn-outline-info flex-fill">
                                <i class="bi bi-journals me-1"></i> Repertório
                            </a>
                            <a asp-action="Edit" asp-route-id="@o.Id" class="btn btn-sm btn-outline-secondary flex-fill">
                                <i class="bi bi-pencil me-1"></i> Editar
                            </a>
                            <form asp-action="AlternarStatus" asp-route-id="@o.Id" method="post" class="flex-fill d-grid">
                                <button type="submit" class="btn btn-sm @(o.Ativo ? "btn-outline-warning" : "btn-outline-success")">
                                    @(o.Ativo ? "Desativar" : "Ativar")
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
