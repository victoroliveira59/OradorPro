@model AgendaPalestras.Application.DTOs.SincronizarRepertorioDto
@{
    ViewData["Title"] = "Gerenciar Repertório";
    var orador = ViewBag.Orador as AgendaPalestras.Application.DTOs.OradorDto;
    var todosDiscursos = ViewBag.TodosDiscursos as IEnumerable<AgendaPalestras.Application.DTOs.DiscursoDto> ?? Enumerable.Empty<AgendaPalestras.Application.DTOs.DiscursoDto>();
    var selecionados = new HashSet<Guid>(Model.DiscursosIds);
}

<div class="row justify-content-center">
    <div class="col-md-9">
        <div class="card shadow-sm">
            <div class="card-header bg-info text-dark d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2">
                <h4 class="mb-0 fs-5"><i class="bi bi-journal-bookmark-fill"></i> Repertório de Discursos</h4>
                <span class="badge bg-dark text-white">@orador?.Nome</span>
            </div>
            <div class="card-body">
                <p class="text-muted small">
                    Marque todos os temas de discursos públicos que <strong>@orador?.Nome</strong> (@orador?.CongregacaoNome) está habilitado a proferir.
                    Apenas estes discursos poderão ser selecionados ao agendar uma palestra para ele.
                </p>

                <form asp-action="Repertorio" method="post">
                    <input type="hidden" asp-for="OradorId" />

                    <div class="row mb-3">
                        <div class="col-12">
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-search"></i></span>
                                <input type="text" id="filtroDiscursos" class="form-control" placeholder="Filtrar discursos por número ou tema..." onkeyup="filtrarLista()">
                            </div>
                        </div>
                    </div>

                    <div class="border rounded p-3 bg-light mb-4" style="max-height: 400px; overflow-y: auto;">
                        @if (!todosDiscursos.Any())
                        {
                            <div class="text-muted text-center py-3">Nenhum discurso cadastrado no catálogo.</div>
                        }
                        @foreach (var d in todosDiscursos)
                        {
                            var isChecked = selecionados.Contains(d.Id);
                            <div class="form-check mb-2 item-discurso">
                                <input class="form-check-input" type="checkbox" name="DiscursosIds" value="@d.Id" id="disc_@d.Id" @(isChecked ? "checked" : "")>
                                <label class="form-check-label w-100" for="disc_@d.Id">
                                    <span class="badge bg-secondary me-2">Nº @d.Numero</span>
                                    <span class="texto-tema">@d.Tema</span>
                                </label>
                            </div>
                        }
                    </div>

                    <div class="d-flex flex-column flex-sm-row justify-content-between gap-2 border-top pt-3">
                        <a asp-action="Index" class="btn btn-outline-secondary order-2 order-sm-1 text-center">Voltar</a>
                        <button type="submit" class="btn btn-primary order-1 order-sm-2 text-center"><i class="bi bi-check-lg"></i> Salvar Repertório</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function filtrarLista() {
        var input = document.getElementById('filtroDiscursos').value.toLowerCase();
        var items = document.getElementsByClassName('item-discurso');
        for (var i = 0; i < items.length; i++) {
            var text = items[i].innerText.toLowerCase();
            items[i].style.display = text.includes(input) ? '' : 'none';
        }
    }
</script>
