@model AgendaPalestras.Application.DTOs.AtualizarOradorDto
@{
    ViewData["Title"] = "Editar Orador";
    var congregacoes = ViewBag.Congregacoes as IEnumerable<AgendaPalestras.Application.DTOs.CongregacaoDto> ?? Enumerable.Empty<AgendaPalestras.Application.DTOs.CongregacaoDto>();
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-secondary text-white">
                <h4 class="mb-0">Editar Dados do Orador</h4>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="CongregacaoId" class="form-label">Congregação de Origem *</label>
                            <select asp-for="CongregacaoId" class="form-select" required>
                                @foreach (var c in congregacoes)
                                {
                                    <option value="@c.Id" selected="@(c.Id == Model.CongregacaoId ? "selected" : null)">@c.Nome (@c.Cidade)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Nome" class="form-label">Nome Completo *</label>
                            <input asp-for="Nome" class="form-control" required />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="TelefoneWhatsapp" class="form-label">Telefone WhatsApp *</label>
                            <input asp-for="TelefoneWhatsapp" class="form-control" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Email" class="form-label">E-mail</label>
                            <input asp-for="Email" type="email" class="form-control" />
                        </div>
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" asp-for="Ativo" id="ativoSwitch">
                        <label class="form-check-label" for="ativoSwitch">Orador Ativo</label>
                    </div>

                    <div class="d-flex flex-column flex-sm-row justify-content-between gap-2 mt-4 border-top pt-3">
                        <a asp-action="Index" class="btn btn-outline-secondary order-2 order-sm-1 text-center">Cancelar</a>
                        <button type="submit" class="btn btn-primary order-1 order-sm-2 text-center">Salvar Alterações</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
