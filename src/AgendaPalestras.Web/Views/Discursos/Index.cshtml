@model IEnumerable<AgendaPalestras.Application.DTOs.DiscursoDto>
@{
    ViewData["Title"] = "Discursos Públicos";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-4 gap-3">
    <div>
        <h2 class="mb-1"><i class="bi bi-journal-text"></i> Discursos Públicos</h2>
        <p class="text-muted small mb-0">Catálogo oficial de temas de palestras públicas disponíveis.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary w-100 w-sm-auto"><i class="bi bi-plus-circle"></i> Novo Discurso</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Visualização Desktop (Tabela) -->
<div class="card shadow-sm border-0 d-none d-md-block">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 100px;">Nº</th>
                        <th>Tema do Discurso</th>
                        <th style="width: 120px;">Status</th>
                        <th class="text-end" style="width: 180px;">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">Nenhum discurso cadastrado no catálogo.</td>
                        </tr>
                    }
                    @foreach (var d in Model)
                    {
                        <tr>
                            <td class="fw-bold">Nº @d.Numero</td>
                            <td>@d.Tema</td>
                            <td>
                                @if (d.Ativo)
                                {
                                    <span class="badge bg-success">Ativo</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inativo</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@d.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                                <form asp-action="AlternarStatus" asp-route-id="@d.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm @(d.Ativo ? "btn-outline-warning" : "btn-outline-success")">
                                        @(d.Ativo ? "Desativar" : "Ativar")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Visualização Mobile (Cards) -->
<div class="d-md-none">
    @if (!Model.Any())
    {
        <div class="card shadow-sm border-0 text-center py-4">
            <div class="card-body">
                <i class="bi bi-journal-x text-muted fs-1 mb-2 d-block"></i>
                <h5 class="fw-bold text-dark">Nenhum discurso cadastrado</h5>
            </div>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-3 mb-4">
            @foreach (var d in Model)
            {
                <div class="card shadow-sm border-0 mobile-agenda-card border-start border-4 @(d.Ativo ? "border-info" : "border-secondary")">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge bg-dark fs-6 px-2 py-1">
                                Nº @d.Numero
                            </span>
                            <span class="badge @(d.Ativo ? "bg-success" : "bg-danger")">
                                @(d.Ativo ? "Ativo" : "Inativo")
                            </span>
                        </div>

                        <h6 class="fw-bold text-dark mb-3">@d.Tema</h6>

                        <div class="d-flex gap-2 border-top pt-2">
                            <a asp-action="Edit" asp-route-id="@d.Id" class="btn btn-sm btn-outline-secondary flex-fill text-center">
                                <i class="bi bi-pencil me-1"></i> Editar
                            </a>
                            <form asp-action="AlternarStatus" asp-route-id="@d.Id" method="post" class="flex-fill d-grid">
                                <button type="submit" class="btn btn-sm @(d.Ativo ? "btn-outline-warning" : "btn-outline-success")">
                                    @(d.Ativo ? "Desativar" : "Ativar")
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
