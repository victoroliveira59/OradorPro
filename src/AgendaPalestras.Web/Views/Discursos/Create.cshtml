@model AgendaPalestras.Application.DTOs.CriarDiscursoDto
@{
    ViewData["Title"] = "Novo Discurso";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Cadastrar Novo Discurso</h4>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="Numero" class="form-label">Número do Esboço / Discurso *</label>
                        <input asp-for="Numero" type="number" min="1" class="form-control" style="max-width: 150px;" required />
                        <span asp-validation-for="Numero" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Tema" class="form-label">Tema Oficial do Discurso *</label>
                        <input asp-for="Tema" class="form-control" placeholder="Ex: Quem é Deus?, Como vencer as ansiedades da vida" required />
                        <span asp-validation-for="Tema" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-primary">Salvar Discurso</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
