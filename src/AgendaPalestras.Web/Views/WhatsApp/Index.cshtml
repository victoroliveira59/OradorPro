@model AgendaPalestras.Web.Models.WhatsAppConnectionViewModel
@{
    ViewData["Title"] = "Conexão WhatsApp (Evolution API)";
}

<div class="row align-items-center mb-4">
    <div class="col-md-8">
        <h2 class="fw-bold mb-1"><i class="bi bi-whatsapp text-success"></i> Conexão WhatsApp</h2>
        <p class="text-muted mb-0">Gerencie a conexão do WhatsApp do Administrador com a Evolution API para envio automatizado de convites e lembretes.</p>
    </div>
    <div class="col-md-4 text-md-end mt-3 mt-md-0">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-clockwise"></i> Recarregar</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4">
    <!-- Card de Status e Conexão -->
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 border-0">
                <h5 class="card-title fw-bold mb-0 text-dark">
                    <i class="bi bi-broadcast text-primary me-2"></i> Status da Conexão
                </h5>
            </div>
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between p-3 rounded bg-light mb-4">
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold">Estado Atual</div>
                        <div class="fs-5 fw-bold" id="status-texto">
                            @if (Model.Status.Conectado)
                            {
                                <span class="badge bg-success px-3 py-2"><i class="bi bi-check-circle me-1"></i> Conectado (Online)</span>
                            }
                            else if (Model.Status.State == "connecting")
                            {
                                <span class="badge bg-warning text-dark px-3 py-2"><i class="bi bi-hourglass-split me-1"></i> Conectando...</span>
                            }
                            else if (Model.Status.State == "not_created")
                            {
                                <span class="badge bg-secondary px-3 py-2"><i class="bi bi-plus-circle me-1"></i> Instância Não Criada</span>
                            }
                            else
                            {
                                <span class="badge bg-danger px-3 py-2"><i class="bi bi-x-circle me-1"></i> Desconectado</span>
                            }
                        </div>
                    </div>
                    <div class="text-end">
                        <div class="text-muted small">Instância</div>
                        <span class="badge bg-dark">@Model.Configuracao.InstanceName</span>
                    </div>
                </div>

                @if (!Model.Status.Conectado)
                {
                    <div class="text-center py-2 mb-3">
                        <p class="text-muted">Clique no botão abaixo para gerar o QR Code de autenticação com o WhatsApp do Administrador.</p>
                        <form asp-action="Conectar" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-success btn-lg px-4 shadow-sm">
                                <i class="bi bi-qr-code me-2"></i> Conectar / Gerar QR Code
                            </button>
                        </form>
                    </div>

                    @if (Model.QrCode != null && !string.IsNullOrEmpty(Model.QrCode.QrCodeBase64))
                    {
                        <div class="border rounded p-4 text-center bg-white shadow-sm mt-3" id="area-qrcode">
                            <h6 class="fw-bold text-success mb-2"><i class="bi bi-camera me-1"></i> Escaneie o QR Code no seu celular</h6>
                            <div class="my-3">
                                <img src="@Model.QrCode.QrCodeBase64" alt="QR Code WhatsApp" class="img-fluid border rounded p-2 bg-white shadow-sm" style="max-width: 250px;" />
                            </div>

                            @if (!string.IsNullOrEmpty(Model.QrCode.PairingCode))
                            {
                                <div class="alert alert-info py-2 px-3 d-inline-block mb-3">
                                    <small class="d-block text-muted">Código de Pareamento:</small>
                                    <strong class="fs-5 letter-spacing-2">@Model.QrCode.PairingCode</strong>
                                </div>
                            }

                            <ol class="text-start small text-muted mx-auto" style="max-width: 320px;">
                                <li>Abra o WhatsApp no aparelho do administrador.</li>
                                <li>Acesse <strong>Aparelhos Conectados</strong>.</li>
                                <li>Toque em <strong>Conectar um aparelho</strong>.</li>
                                <li>Aponte a câmera para o QR Code acima.</li>
                            </ol>
                            <div class="text-muted small mt-2">
                                <span class="spinner-border spinner-border-sm text-success me-1" role="status"></span>
                                Aguardando leitura do QR Code... Atualizando automaticamente.
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="alert alert-success d-flex align-items-center mb-4" role="alert">
                        <i class="bi bi-shield-check fs-2 me-3 text-success"></i>
                        <div>
                            <strong>WhatsApp Ativo e Pronto!</strong>
                            <div class="small">A automação está utilizando este número para disparar convites de palestras e lembretes aos oradores.</div>
                        </div>
                    </div>

                    <form asp-action="Desconectar" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger w-100" onclick="return confirm('Deseja realmente desconectar esta sessão do WhatsApp?');">
                            <i class="bi bi-power me-2"></i> Desconectar WhatsApp
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>

    <!-- Coluna Direita: Teste de Envio e Configurações da API -->
    <div class="col-lg-6">
        <!-- Card de Teste de Envio -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 border-0">
                <h5 class="card-title fw-bold mb-0 text-dark">
                    <i class="bi bi-send text-primary me-2"></i> Teste de Disparo
                </h5>
            </div>
            <div class="card-body">
                <p class="text-muted small">Envie uma mensagem de teste para verificar se o WhatsApp conectado está entregando mensagens normalmente.</p>
                <form asp-action="TestarEnvio" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Número do Destinatário (com DDD)</label>
                        <input type="text" name="Telefone" class="form-control" placeholder="(11) 98888-7777 ou 5511988887777" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Mensagem de Teste</label>
                        <textarea name="Mensagem" class="form-control" rows="2" required>Olá! Este é um teste de envio da plataforma Agenda de Palestras via Evolution API.</textarea>
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm px-4">
                        <i class="bi bi-send-check me-1"></i> Disparar Mensagem de Teste
                    </button>
                </form>
            </div>
        </div>

        <!-- Card de Configurações da Evolution API -->
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 border-0">
                <h5 class="card-title fw-bold mb-0 text-dark">
                    <i class="bi bi-gear text-secondary me-2"></i> Parâmetros da Evolution API
                </h5>
            </div>
            <div class="card-body">
                <form asp-action="SalvarConfiguracao" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">URL da Evolution API</label>
                        <input type="url" name="ApiUrl" class="form-control" value="@Model.Configuracao.ApiUrl" placeholder="http://localhost:8080 ou https://evolution.seuservidor.com" required />
                        <div class="form-text small">Endereço base do servidor da Evolution API.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Chave de API (Global ApiKey)</label>
                        <input type="text" name="ApiKey" class="form-control font-monospace" value="@Model.Configuracao.ApiKey" placeholder="Sua chave secreta da Evolution API" />
                        <div class="form-text small">Header <code>apikey</code> utilizado para autenticação.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Nome da Instância</label>
                        <input type="text" name="InstanceName" class="form-control" value="@Model.Configuracao.InstanceName" placeholder="oradorpro-admin" required />
                        <div class="form-text small">Identificador único da instância WhatsApp na Evolution API.</div>
                    </div>
                    <button type="submit" class="btn btn-outline-dark btn-sm px-3">
                        <i class="bi bi-save me-1"></i> Salvar Parâmetros
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Polling para checar status em tempo real caso o QR Code esteja visível
        (function() {
            var areaQr = document.getElementById('area-qrcode');
            if (areaQr) {
                var timer = setInterval(function() {
                    fetch('@Url.Action("Status", "WhatsApp")')
                        .then(function(res) { return res.json(); })
                        .then(function(data) {
                            if (data && data.conectado) {
                                clearInterval(timer);
                                window.location.reload();
                            }
                        })
                        .catch(function(err) {
                            console.log('Verificando status...', err);
                        });
                }, 4000);
            }
        })();
    </script>
}
