@model IEnumerable<AgendaPalestras.Application.DTOs.CongregacaoDto>
@{
    ViewData["Title"] = "Congregações";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-4 gap-3">
    <div>
        <h2 class="mb-1"><i class="bi bi-building"></i> Congregações</h2>
        <p class="text-muted small mb-0">Administração das congregações parceiras cadastradas.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i> Nova Congregação</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Visualização Desktop (Tabela) -->
<div class="card shadow-sm border-0 d-none d-md-block">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Nome</th>
                        <th>Cidade</th>
                        <th>Circuito</th>
                        <th>Reuniões</th>
                        <th>Oradores</th>
                        <th>Status</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">Nenhuma congregação cadastrada até o momento.</td>
                        </tr>
                    }
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td class="fw-bold">@c.Nome</td>
                            <td>@c.Cidade</td>
                            <td>@c.Circuito</td>
                            <td><small>@c.DiasReuniao - @c.HorarioReuniao</small></td>
                            <td><span class="badge bg-secondary">@c.TotalOradores</span></td>
                            <td>
                                @if (c.Ativo)
                                {
                                    <span class="badge bg-success">Ativa</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inativa</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                                <form asp-action="AlternarStatus" asp-route-id="@c.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm @(c.Ativo ? "btn-outline-warning" : "btn-outline-success")">
                                        @(c.Ativo ? "Desativar" : "Ativar")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Visualização Mobile (Cards) -->
<div class="d-md-none">
    @if (!Model.Any())
    {
        <div class="card shadow-sm border-0 text-center py-4">
            <div class="card-body">
                <i class="bi bi-building-x text-muted fs-1 mb-2 d-block"></i>
                <h5 class="fw-bold text-dark">Nenhuma congregação cadastrada</h5>
            </div>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-3 mb-4">
            @foreach (var c in Model)
            {
                <div class="card shadow-sm border-0 mobile-agenda-card border-start border-4 @(c.Ativo ? "border-primary" : "border-secondary")">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <h5 class="fw-bold text-dark mb-0">@c.Nome</h5>
                                <span class="text-muted small">@c.Cidade (@c.Circuito)</span>
                            </div>
                            <span class="badge @(c.Ativo ? "bg-success" : "bg-danger")">
                                @(c.Ativo ? "Ativa" : "Inativa")
                            </span>
                        </div>

                        <div class="small text-muted mb-2">
                            <div><i class="bi bi-clock me-1"></i> Reunião: <strong>@c.DiasReuniao às @c.HorarioReuniao</strong></div>
                            <div><i class="bi bi-people me-1"></i> Oradores cadastrados: <strong>@c.TotalOradores</strong></div>
                        </div>

                        <div class="d-flex gap-2 border-top pt-2">
                            <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-secondary flex-fill text-center">
                                <i class="bi bi-pencil me-1"></i> Editar
                            </a>
                            <form asp-action="AlternarStatus" asp-route-id="@c.Id" method="post" class="flex-fill d-grid">
                                <button type="submit" class="btn btn-sm @(c.Ativo ? "btn-outline-warning" : "btn-outline-success")">
                                    @(c.Ativo ? "Desativar" : "Ativar")
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
