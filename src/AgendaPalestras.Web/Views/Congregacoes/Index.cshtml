@model IEnumerable<AgendaPalestras.Application.DTOs.CongregacaoDto>
@{
    ViewData["Title"] = "Congregações";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1"><i class="bi bi-building"></i> Congregações</h2>
        <p class="text-muted">Administração das congregações parceiras cadastradas.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Nova Congregação</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Nome</th>
                        <th>Cidade</th>
                        <th>Circuito</th>
                        <th>Reuniões</th>
                        <th>Oradores</th>
                        <th>Status</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">Nenhuma congregação cadastrada até o momento.</td>
                        </tr>
                    }
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td class="fw-bold">@c.Nome</td>
                            <td>@c.Cidade</td>
                            <td>@c.Circuito</td>
                            <td><small>@c.DiasReuniao - @c.HorarioReuniao</small></td>
                            <td><span class="badge bg-secondary">@c.TotalOradores</span></td>
                            <td>
                                @if (c.Ativo)
                                {
                                    <span class="badge bg-success">Ativa</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inativa</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                                <form asp-action="AlternarStatus" asp-route-id="@c.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm @(c.Ativo ? "btn-outline-warning" : "btn-outline-success")">
                                        @(c.Ativo ? "Desativar" : "Ativar")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
