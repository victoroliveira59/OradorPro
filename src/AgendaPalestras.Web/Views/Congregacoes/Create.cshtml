@model AgendaPalestras.Application.DTOs.CriarCongregacaoDto
@{
    ViewData["Title"] = "Nova Congregação";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Cadastrar Nova Congregação</h4>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="Nome" class="form-label">Nome da Congregação *</label>
                        <input asp-for="Nome" class="form-control" placeholder="Ex: Central, Jardim das Flores" required />
                        <span asp-validation-for="Nome" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Cidade" class="form-label">Cidade</label>
                            <input asp-for="Cidade" class="form-control" placeholder="Ex: São Paulo" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Circuito" class="form-label">Circuito</label>
                            <input asp-for="Circuito" class="form-control" placeholder="Ex: SP-04" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="DiasReuniao" class="form-label">Dia da Reunião de Fim de Semana</label>
                            <input asp-for="DiasReuniao" class="form-control" placeholder="Ex: Domingo ou Sábado" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="HorarioReuniao" class="form-label">Horário da Reunião</label>
                            <input asp-for="HorarioReuniao" class="form-control" placeholder="Ex: 18:00" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Endereco" class="form-label">Endereço do Salão do Reino</label>
                            <input asp-for="Endereco" class="form-control" placeholder="Ex: Rua das Flores, 123" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="LinkGoogleMaps" class="form-label">Link do Google Maps</label>
                            <input asp-for="LinkGoogleMaps" type="url" class="form-control" placeholder="https://maps.app.goo.gl/..." />
                        </div>
                    </div>

                    <div class="d-flex flex-column flex-sm-row justify-content-between gap-2 mt-4 border-top pt-3">
                        <a asp-action="Index" class="btn btn-outline-secondary order-2 order-sm-1 text-center">Cancelar</a>
                        <button type="submit" class="btn btn-primary order-1 order-sm-2 text-center">Salvar Congregação</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
